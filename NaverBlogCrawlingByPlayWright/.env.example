# 이 파일을 복사해 `.env` 로 저장한 뒤 값만 채우세요. (`.env`는 Git에 올리지 마세요.)

# --- 네이버 블로그 검색 API (크롤링 키워드 검색) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- AI 글작성 (OpenAI 또는 Gemini, 키는 하나 이상) ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# 선택: openai | gemini | auto (미입력 시 auto — OpenAI 키 우선)
# BLOG_AI_PROVIDER=auto

# 선택: 모델명 (GUI에서 모델을 고른 경우 GUI 값이 우선합니다.)
# OPENAI_MODEL=gpt-5.4
# GEMINI_MODEL=gemini-2.0-flash

# AI 글작성이 성공할 때마다 스크립트 폴더의 api_usage_stats.json 에 호출 횟수가 누적됩니다.
